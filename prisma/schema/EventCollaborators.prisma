// Usuarios invitados por el organizador a ayudar a gestionar un evento.
// Un mismo usuario sólo puede ser colaborador una vez por evento.
model EventCollaborators {
	id Int @id @default(autoincrement())
	event Events @relation(fields: [eventFK], references: [id], onDelete: Cascade)
	eventFK Int
	user User @relation(fields: [userFK], references: [id], onDelete: Cascade)
	userFK Int
	createdAt DateTime @default(now())

	@@unique([eventFK, userFK])
	@@index([eventFK])
	@@index([userFK])
}
